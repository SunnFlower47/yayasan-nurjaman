# ==============================================================================
# YAYASAN NURJAMAN BONGAS PURWAKARTA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` untuk konfigurasi lokal Anda:
#   cp .env.example .env
# PENTING: DILARANG memasukkan nilai rahasia asli (password, kunci API privat) ke file ini!
# ==============================================================================

# Lingkungan aplikasi ('development' | 'production' | 'test')
NODE_ENV=development

# Port aplikasi Next.js saat dijalankan secara lokal / container
PORT=3000

# URL publik aplikasi (digunakan untuk link absolut, metadata SEO, webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama resmi lembaga untuk branding
NEXT_PUBLIC_APP_NAME="Yayasan Nurjaman Bongas Purwakarta"

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL (Prisma Connection String)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
# Untuk docker compose dev bawaan:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yayasan_nurjaman?schema=public"

# Kredensial untuk Docker Compose PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yayasan_nurjaman
POSTGRES_PORT=5432
