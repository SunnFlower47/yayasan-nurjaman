# ==============================================================================
# YAYASAN NURJAMAN BONGAS PURWAKARTA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini menjadi `.env` untuk konfigurasi lokal Anda:
#   cp .env.example .env
# PENTING: DILARANG memasukkan nilai rahasia asli (password, kunci API privat) ke berkas ini!
# ==============================================================================

# Lingkungan aplikasi ('development' | 'production' | 'test')
NODE_ENV=development

# Port aplikasi Next.js saat dijalankan secara lokal / container
PORT=3000

# URL publik aplikasi (digunakan untuk link absolut, metadata SEO, webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama resmi lembaga untuk branding
NEXT_PUBLIC_APP_NAME="Yayasan Nurjaman Bongas Purwakarta"

# Versi aplikasi (dicatat di manifest backup dan footer admin)
APP_VERSION=0.1.0

# Domain publik server untuk Caddy reverse proxy dan sertifikat TLS otomatis
DOMAIN_NAME=localhost

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL & PEMISAHAN HAK AKSES ROLE (LEAST PRIVILEGE)
# ------------------------------------------------------------------------------
# Nama database utama
POSTGRES_DB=yayasan_db

# Akun Admin / Superuser (Hanya digunakan saat bootstrap/inisialisasi container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# 1. Role Migrator: Pemilik skema DDL (digunakan layanan migrate dan restore)
DB_MIGRATOR_USER=db_migrator
DB_MIGRATOR_PASSWORD=

# 2. Role Aplikasi (db_app): Hak akses minimal DML (SELECT/INSERT/UPDATE/DELETE), NO DDL
DB_APP_USER=db_app
DB_APP_PASSWORD=

# 3. Role Backup (db_backup): Hak akses baca pg_dump, bukan superuser
DB_BACKUP_USER=db_backup
DB_BACKUP_PASSWORD=

# String koneksi host development lokal:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yayasan_nurjaman?schema=public"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# AUTENTIKASI & KEAMANAN SESI (ADR-011 In-House Auth)
# ------------------------------------------------------------------------------
# Kunci rahasia penandatangan cookie sesi (minimal 32 karakter acak kriptografis)
AUTH_SECRET=

# ------------------------------------------------------------------------------
# KEY RING ENKRIPSI APLIKASI (AES-256-GCM) & BLIND INDEX (HMAC-SHA256)
# ------------------------------------------------------------------------------
# ID kunci aktif untuk enkripsi data baru
ENCRYPTION_KEY_ACTIVE_ID=k1

# Kamus JSON seluruh kunci enkripsi (mendukung rotasi multi-kunci historis)
ENCRYPTION_KEYS='{"k1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'

# Kunci rahasia HMAC blind index terpisah untuk pencarian NIK tanpa membuka ciphertext
BLIND_INDEX_SECRET=

# ------------------------------------------------------------------------------
# CADANGAN TERAUTENTIKASI (RESTIC / AES-256 POLY1305) & RETENSI
# ------------------------------------------------------------------------------
# Kunci enkripsi repositori backup restic
RESTIC_PASSWORD=
BACKUP_ENCRYPTION_KEY=

# Jadwal backup otomatis Supercronic (format standard cron, default: jam 02:00 pagi setiap hari)
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Kebijakan retensi backup otomatis
RETENTION_DAYS=7
RETENTION_KEEP=10

# ------------------------------------------------------------------------------
# PENYIMPANAN OFFSITE S3-COMPATIBLE (Cloudflare R2 / AWS S3 / Wasabi / MinIO)
# ------------------------------------------------------------------------------
# Biarkan kosong jika belum menggunakan offsite (akan menampilkan peringatan keras)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ------------------------------------------------------------------------------
# INISIALISASI AKUN SUPER ADMIN AWAL (SEED TANPA DEFAULT)
# ------------------------------------------------------------------------------
# Ketiga variabel ini WAJIB diisi saat bootstrap awal basis data jika akun admin belum terdaftar.
# Tidak ada nilai default fallback di kode sumber demi keamanan.
# Kata sandi wajib memenuhi standar docs/SECURITY.md (min. 12 karakter, tidak memuat username/email,
# dan bukan kata sandi pasaran). Jangan pernah memasukkan nilai kredensial asli ke berkas ini!
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
