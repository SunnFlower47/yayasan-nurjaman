# ==============================================================================
# YAYASAN NURJAMAN BONGAS PURWAKARTA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini menjadi `.env` untuk konfigurasi lokal Anda:
#   cp .env.example .env
# PENTING: DILARANG memasukkan nilai rahasia asli (password, kunci API privat) ke berkas ini!
# ==============================================================================

# Lingkungan aplikasi ('development' | 'production' | 'test')
NODE_ENV=development

# Port aplikasi Next.js saat dijalankan secara lokal / container
PORT=3000

# URL publik aplikasi (digunakan untuk link absolut, metadata SEO, webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama resmi lembaga untuk branding
NEXT_PUBLIC_APP_NAME="Yayasan Nurjaman Bongas Purwakarta"

# Versi aplikasi (ditampilkan di footer admin dan dicatat di manifest backup)
APP_VERSION=0.1.0

# Domain publik server untuk Caddy reverse proxy dan sertifikat TLS otomatis
DOMAIN_NAME=localhost

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL (Prisma Connection String)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
# Untuk docker compose dev bawaan (koneksi dari host):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yayasan_nurjaman?schema=public"

# Kredensial untuk Docker Compose PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yayasan_nurjaman
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# AUTENTIKASI & KEAMANAN SESI (ADR-011 In-House Auth)
# ------------------------------------------------------------------------------
# Kunci rahasia penandatangan cookie sesi (minimal 32 karakter acak kriptografis)
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-kunci-rahasia-autentikasi-minimal-32-karakter-acak

# ------------------------------------------------------------------------------
# KEY RING ENKRIPSI APLIKASI (AES-256-GCM) & BLIND INDEX (HMAC-SHA256)
# ------------------------------------------------------------------------------
# ID kunci yang saat ini aktif digunakan untuk mengenkripsi kolom data baru
ENCRYPTION_KEY_ACTIVE_ID=k1

# Daftar key ring berformat JSON berisi seluruh kunci enkripsi heksadesimal 32-byte (64 hex chars).
# Mendukung rotasi: kunci aktif dan kunci lama untuk dekripsi data historis.
# Buat kunci baru dengan: openssl rand -hex 32
ENCRYPTION_KEYS='{"k1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'

# Kunci rahasia HMAC blind index terpisah untuk pencarian NIK tanpa membuka ciphertext
# Buat dengan: openssl rand -hex 32
BLIND_INDEX_SECRET=ganti-dengan-kunci-blind-index-heksadesimal-32-byte-rahasia

# ------------------------------------------------------------------------------
# CADANGAN & ENKRIPSI BACKUP (OpenSSL AES-256-CBC PBKDF2)
# ------------------------------------------------------------------------------
# Kunci simetris untuk mengenkripsi arsip dump basis data dan berkas uploads
BACKUP_ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-cadangan-rahasia-sistem

# ------------------------------------------------------------------------------
# PENYIMPANAN OFFSITE S3-COMPATIBLE (Cloudflare R2 / AWS S3 / Wasabi / MinIO)
# ------------------------------------------------------------------------------
# Biarkan kosong jika belum menggunakan offsite (akan menampilkan peringatan di backup worker)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
