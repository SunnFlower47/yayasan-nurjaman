# Caddyfile untuk Reverse Proxy Yayasan Nurjaman Bongas Purwakarta
# Kepemilikan Tunggal Header Keamanan (ADR-024):
# - Jalur Aplikasi (/ dan API): Seluruh security headers (CSP berbasis nonce, HSTS 2 tahun,
#   X-Frame-Options, dsb.) dikelola secara berdaulat oleh middleware Next.js.
#   Caddy DILARANG menimpa atau menambahkan CSP/HSTS pada respon aplikasi.
# - Jalur Statis Publik (/uploads/*): Dikelola langsung oleh Caddy dengan isolasi ketat.

{
	# Nonaktifkan endpoint admin Caddy demi keamanan
	admin off
}

{$DOMAIN_NAME:localhost} {
	# Global: sembunyikan identitas server Caddy
	header -Server

	# Batasi ukuran request body (mencegah DoS)
	request_body {
		max_size 5MB
	}

	# 1. Jalur statis publik /uploads/* (Pemilik header: Caddy)
	handle_path /uploads/* {
		header {
			# Mencegah MIME-sniffing
			X-Content-Type-Options "nosniff"

			# CSP ketat untuk file upload statis (tanpa script eksternal, sandbox)
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"

			# Proteksi frame
			X-Frame-Options "DENY"

			# Kebijakan perujuk
			Referrer-Policy "no-referrer"
		}

		# File non-gambar dipaksa unduh (attachment) demi mencegah eksekusi script/HTML liar
		@nonImage not path *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico
		header @nonImage Content-Disposition "attachment"
		header !@nonImage Content-Disposition "inline"

		root * /var/data/uploads_public
		file_server
	}

	# 2. Jalur dinamis aplikasi (Pemilik header: Middleware Next.js)
	handle {
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
