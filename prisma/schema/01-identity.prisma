enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOCKOUT
  PERMISSION_DENIED
  ROLE_CHANGED
  SESSION_REVOKED
  TWO_FACTOR_CHANGED
  MFA_CHALLENGE
  MFA_VERIFIED
  MFA_FAILED
  MFA_RECOVERY_USED
  MFA_RESET
  BACKUP_DOWNLOADED
  RESTORE_STARTED

  @@map("security_event_type")
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String
  email              String
  name               String
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  memberId           String?    @map("member_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions               Session[]
  twoFactorSecret        TwoFactorSecret?
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  passwordResetTokens    PasswordResetToken[]
  userRoles              UserRole[]              @relation("UserRolesTarget")
  assignedRoles          UserRole[]              @relation("UserRolesAssigner")
  auditLogs              AuditLog[]
  securityEvents         SecurityEvent[]

  @@map("users")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  ip                String?   @db.Inet
  userAgent         String?   @map("user_agent")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  reauthAt          DateTime? @map("reauth_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model TwoFactorSecret {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  secret       Bytes     @map("secret")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RateLimitCounter {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String
  windowStart  DateTime  @map("window_start") @db.Timestamptz(6)
  hitCount     Int       @default(1) @map("hit_count")
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([key, windowStart])
  @@index([blockedUntil])
  @@map("rate_limit_counters")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user     User @relation("UserRolesTarget", fields: [userId], references: [id], onDelete: Cascade)
  role     Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User @relation("UserRolesAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  metadata    Json?    @db.JsonB

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  type       SecurityEventType
  userId     String?           @map("user_id") @db.Uuid
  ip         String?           @db.Inet
  userAgent  String?           @map("user_agent")
  details    Json?             @db.JsonB

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@map("security_events")
}
