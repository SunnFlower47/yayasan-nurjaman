{
  "name": "yayasan-nurjaman",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "changelog:new": "node scripts/new-changelog.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "15.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.21.0",
    "eslint-config-next": "15.2.1",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "postcss": "8.5.3",
    "prettier": "3.5.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "6.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
