{
  "name": "yayasan-nurjaman",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && node scripts/check-layers.mjs",
    "security:audit": "pnpm audit",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "db:migrate": "docker compose run --rm migrate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "changelog:new": "node scripts/new-changelog.mjs",
    "prepare": "husky",
    "admin:reset-2fa": "tsx scripts/reset-2fa.ts"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.65.0",
    "@types/node": "22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "postcss": "8.5.23",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
